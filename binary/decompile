def params_txt(fn):
    ps = [p[1].decode() for p in fn["param"] if p[0] == "str"]
    ps = [p for p in ps if p != "this"]
    if fn["vargs"]:
        ps.append("...")
    return ", ".join(ps)


def render_fn(fn, name, ind, kw="function"):
    head = f"{ind}{kw} {name}({params_txt(fn)})" if name else f"{ind}function({params_txt(fn)})"
    try:
        d = Decomp(fn, name or "")
        stmts = d.run()
        body = render(stmts, ind + "    ", fn)
    except Exception as ex:  # repli : on ne cache rien
        body = [f"{ind}    /* décompilation impossible ({ex}) : voir gsb_asm.py */"]
    if not body:
        return [head + " {}"]
    return [head, ind + "{"] + body + [ind + "}"]


def render(stmts, ind, fn):
    L = []
    for st in stmts:
        k = st[0]
        if k == "line":
            L.append(ind + st[1])
        elif k == "empty":
            pass
        elif k == "block":
            L.append(ind + "{")
            L += render(st[1], ind + "    ", fn)
            L.append(ind + "}")
        elif k == "if":
            _, c, then, els = st
            L.append(f"{ind}if ({c}) {{")
            L += render(then, ind + "    ", fn)
            while els:
                if len(els) == 1 and els[0][0] == "if":
                    _, c2, t2, e2 = els[0]
                    L.append(f"{ind}}} else if ({c2}) {{")
                    L += render(t2, ind + "    ", fn)
                    els = e2
                else:
                    L.append(f"{ind}}} else {{")
                    L += render(els, ind + "    ", fn)
                    els = None
            L.append(ind + "}")
        elif k == "while":
            L.append(f"{ind}while ({st[1]}) {{")
            L += render(st[2], ind + "    ", fn)
            L.append(ind + "}")
        elif k == "dowhile":
            L.append(f"{ind}do {{")
            L += render(st[2], ind + "    ", fn)
            L.append(f"{ind}}} while ({st[1]});")
        elif k == "switch":
            _, subj, cases, default = st
            L.append(f"{ind}switch ({subj}) {{")
            for v, body in cases:
                L.append(f"{ind}    case {v}:")
                L += render(body, ind + "        ", fn)
            if default:
                L.append(f"{ind}    default:")
                L += render(default, ind + "        ", fn)
            L.append(ind + "}")
        elif k == "func":
            nom, idx = st[1], st[2]
            kw = "local function" if len(st) > 3 else "function"
            L.append("")
            L += render_fn(fn["fn"][idx], nom, ind, kw)
        elif k == "class":
            nom, meta = st[1], st[2]
            L.append("")
            base = f" extends {meta['base']}" if meta["base"] else ""
            L.append(f"{ind}class {nom}{base}")
            L.append(ind + "{")
            for key, val, static in meta["members"]:
                kn = key.meta if key.kind == "str" else key.t
                pre = "static " if static else ""
                if val.kind == "closure":
                    L.append("")
                    L += render_fn(fn["fn"][val.meta], kn, ind + "    ")
                else:
                    L.append(f"{ind}    {pre}{kn} = {val.t};")
            L.append(ind + "}")
    return L


def parse_args(argv):
    """Sépare l'option -o/--output des autres arguments."""
    out, rest, i = None, [], 0
    while i < len(argv):
        if argv[i] in ("-o", "--output"):
            if i + 1 >= len(argv):
                sys.exit("erreur : -o attend un chemin")
            out = argv[i + 1]
            i += 2
        else:
            rest.append(argv[i])
            i += 1
    return rest, out


def sortie_defaut(src: Path, ext: str) -> Path:
    """Sortie par défaut dans le dossier courant : fichier -> nom.ext, dossier -> nom_ext/"""
    if src.is_dir():
        return Path.cwd() / f"{src.resolve().name}_{ext.lstrip('.')}"
    return Path.cwd() / (src.stem + ext)

def decompile(data: bytes, nom: str) -> str:
    main = lire_gsb(data)
    d = Decomp(main, "main")
    stmts = d.run()
    lines = [f"// {nom} : décompilé depuis le bytecode Squirrel 2 par gsb_decompile.py", ""]
    lines += render(stmts, "", main)
    return "\n".join(lines).replace("\n\n\n", "\n\n").strip() + "\n"


def main():
    a, out = parse_args(sys.argv[1:])
    if len(a) != 1:
        print(__doc__)
        print("Option : -o CHEMIN  (-o - pour afficher ; sinon : dossier courant, nom.nut)")
        sys.exit(1)
    src = Path(a[0])
    if src.is_dir():
        dst = Path(out) if out else sortie_defaut(src, ".nut")
        n = 0
        for fp in sorted(src.rglob("*.gsb")):
            cible = dst / fp.relative_to(src).with_suffix(".nut")
            cible.parent.mkdir(parents=True, exist_ok=True)
            try:
                cible.write_text(decompile(fp.read_bytes(), fp.name), "utf-8")
                n += 1
            except Exception as e:
                print(f"[ERREUR] {fp} : {e}")
        print(f"{n} fichiers décompilés dans {dst}/")
    else:
        txt = decompile(src.read_bytes(), src.name)
        if out == "-":
            print(txt)
            return
        dst = Path(out) if out else sortie_defaut(src, ".nut")
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(txt, "utf-8")
        print(f"-> {dst}")


if __name__ == "__main__":
    main()
